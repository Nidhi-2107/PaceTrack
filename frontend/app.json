{
  "expo": {
    "name": "PaceTrack",
    "slug": "pacetrack",
    "scheme": "pacetrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pacetrack.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PaceTrack uses your location to track distance, route, and pace during workouts.",
        "NSMotionUsageDescription": "PaceTrack uses motion data to count steps towards your daily fitness goals."
      }
    },
    "android": {
      "package": "com.pacetrack.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#071510",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PaceTrack requires GPS access to track workout distance, speed, and routes."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "PaceTrack uses physical pedometer hardware to monitor daily steps."
        }
      ]
    ]
  }
}
